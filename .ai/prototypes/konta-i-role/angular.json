{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "konta-i-role": {
      "projectType": "application",
      "root": ".",
      "sourceRoot": "src",
      "prefix": "proto",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "../../../libs/ui/.storybook/public/prototypes/konta-i-role",
              "browser": ""
            },
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "baseHref": "/prototypes/konta-i-role/",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.scss"],
            "outputHashing": "none",
            "optimization": false,
            "sourceMap": false
          }
        }
      }
    }
  }
}
